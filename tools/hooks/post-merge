#!/bin/sh
# Rebuild dist/ when work is merged into main, so the packaged application
# follows the branch instead of following whoever remembered to build it.
#
# Off unless asked for:  git config logarc.rebuild true
#
# post-merge rather than post-commit, because work reaches main through a
# merge, and hooking commits would rebuild once per commit on a branch for a
# bundle nobody runs yet. `git pull` fires this too, which is right: a
# partner's merged work belongs in dist/ as much as your own.
#
# Backgrounded: a build takes minutes and no merge should wait on it.
[ "$(git config --bool logarc.rebuild 2>/dev/null)" = "true" ] || exit 0
[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ] || exit 0

# Only when something that ends up in the bundle changed: a documentation
# merge does not need a few hundred megabytes rewritten.
_touched=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null \
    || git diff --name-only HEAD~1 HEAD 2>/dev/null)
case "$_touched" in
    *src/logarc/*|*packaging/*|*pyproject.toml*)
        _root=$(git rev-parse --show-toplevel)
        _py="$_root/.venv/Scripts/python.exe"
        [ -x "$_py" ] || _py=python
        _log="$HOME/.cache/logarc-build.log"
        mkdir -p "$(dirname "$_log")"
        echo "--- $(date '+%Y-%m-%d %H:%M:%S') post-merge $(git rev-parse --short HEAD)" >> "$_log"
        "$_py" "$_root/packaging/rebuild.py" >> "$_log" 2>&1 &
        echo "[logarc] rebuilding dist/ in the background (log: $_log)"
        ;;
    *)
        echo "[logarc] nothing in the bundle changed - dist/ left alone"
        ;;
esac
