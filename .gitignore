# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Type checking / linting caches
.mypy_cache/
.ruff_cache/

# PyInstaller
*.spec.bak

# Editors
.vscode/
.idea/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# --- Project-specific ---

# Case directories hold ingested evidence; never commit them.
case-*/
*.logarc-case/

# Sample and generated logs can be huge. The ground-truth sidecars are larger
# still, and a fixed seed reproduces both exactly — samples/README.md carries
# the commands, which is the part worth versioning.
*.log
*.log.gz
*.truth.json
*.truth.jsonl
!tests/data/**/*.log
!tests/data/**/*.truth.jsonl

# The demo log is the exception to the rule above, and small enough to be one:
# it is the file you open to show somebody what this tool does, so it has to be
# in the repository rather than a command away. `samples/demo/make_demo.py`
# rebuilds it byte-for-byte, and README.md there says which client demonstrates
# what. No truth sidecar ships with it, deliberately — see that README.
!samples/demo/demo.log

# Dataset builds. Tens of megabytes each, and the evaluation figures are pinned to
# their SHA-256 rather than to a seed, so they are checksummed instead of versioned.
# samples/README.md says how to obtain one; docs/evaluation.md records the hashes.
samples/apache-shopfront/

# Credentials and local environment. This tool is pointed at production access
# logs, so a stray `.env` here would be someone's infrastructure rather than
# someone's toy project.
.env
.env.*
.envrc
*.pem
*.key
*.pfx

# Benchmark and evaluation output
benchmarks/results/

# Packaged bundles prepared to hand to someone, and the script that builds them.
handoff/

# CRS sidecar: a compiled Go binary and the ruleset clone it needs. Both are
# fetched or built locally; see crs/README.md.
crs/crs-sidecar
crs/crs-sidecar.exe
vendor/

# Knowledge graph built from this tree by `graphify`. Derived output: rebuilt
# from the source it describes, and stale the moment the source moves.
graphify-out/
